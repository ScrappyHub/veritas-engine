{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"veritas.receipt.v1",
  "title":"Veritas Receipt v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","run_id","ts_utc","repo_root","runner_rel","verifier_rel","vector_rel","exit_code","result","stdout_sha256","verifier_sha256","expected_sha256","actual_sha256","prev_receipt_hash","receipt_hash"],
  "properties":{
    "schema":{"const":"veritas.receipt.v1"},
    "run_id":{"type":"string","pattern":"^[0-9]{8}T[0-9]{6}Z$"},
    "ts_utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "repo_root":{"type":"string","minLength":1},
    "runner_rel":{"type":"string","minLength":1},
    "verifier_rel":{"type":"string","minLength":1},
    "vector_rel":{"type":"string","minLength":1},
    "exit_code":{"type":"integer","minimum":0},
    "result":{"type":"string","enum":["PASS","FAIL"]},
    "stdout_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "verifier_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "expected_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "actual_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "prev_receipt_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "receipt_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
